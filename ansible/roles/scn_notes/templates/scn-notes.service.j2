# {{ ansible_managed }}
[Unit]
Description=SCN Notes: Automerge sync and MCP (scn-notes)
After=network-online.target
Wants=network-online.target

[Service]
User={{ scn_notes_user }}
Group={{ scn_notes_group }}
EnvironmentFile={{ scn_notes_env_file }}
WorkingDirectory={{ scn_notes_home }}
ExecStart={{ scn_notes_bin }}

# Restart=always, not on-failure: the relay exits cleanly on SIGTERM, and a
# clean exit for any other reason (Postgres gone at startup, for instance) is
# still an outage. Every restart re-reads storage, so recovery is free.
Restart=always
RestartSec=5
TimeoutStartSec=30

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# All state lives in Postgres. The binary writes nothing to disk, so it gets no
# writable paths at all — ProtectSystem=strict alone is the whole story here.

[Install]
WantedBy=multi-user.target
