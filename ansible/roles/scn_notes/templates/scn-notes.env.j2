# {{ ansible_managed }}
# scn-notes runtime configuration. Read by systemd via EnvironmentFile
# before the process drops privilege — never world-readable (0600 root:root).

SCN_NOTES_DATABASE_URL={{ scn_notes_database_url }}
SCN_NOTES_BIND={{ scn_notes_host }}:{{ scn_notes_port }}

# Phase B. With auth on, the relay refuses to start if any setting below is
# blank, so a half-rendered file fails the smoke test rather than serving open.
SCN_NOTES_REQUIRE_AUTH={{ scn_notes_require_auth | string | lower }}
SCN_NOTES_OIDC_ISSUER={{ scn_notes_oidc_issuer }}
SCN_NOTES_OIDC_JWKS_URL={{ scn_notes_oidc_jwks_url }}
SCN_NOTES_SYNC_AUDIENCE={{ scn_notes_sync_audience }}
SCN_NOTES_MCP_AUDIENCE={{ scn_notes_mcp_audience }}
SCN_NOTES_MCP_BIND={{ scn_notes_host }}:{{ scn_notes_mcp_port }}

# The notes. host (v0.7.0). The URL is checked at startup: an origin, with no
# path and no trailing slash.
SCN_NOTES_PUBLIC_URL={{ scn_notes_public_url }}
SCN_NOTES_PUBLIC_BIND={{ scn_notes_host }}:{{ scn_notes_public_port }}

# Corliss presents this on /internal/. The same group_vars value Corliss
# renders as SYNC_RELAY_SERVICE_TOKEN.
SCN_NOTES_SERVICE_TOKEN={{ scn_notes_service_token }}

# Attachments (v0.9.0). Off, the routes answer 404 and stored rows stay.
SCN_NOTES_ATTACHMENTS_ENABLED={{ scn_notes_attachments_enabled | string | lower }}
SCN_NOTES_ATTACHMENT_MAX_BYTES={{ scn_notes_attachment_max_bytes }}
SCN_NOTES_ATTACHMENT_WORKSPACE_QUOTA_BYTES={{ scn_notes_attachment_workspace_quota_bytes }}

RUST_LOG=scn_notes=info,samod=info
